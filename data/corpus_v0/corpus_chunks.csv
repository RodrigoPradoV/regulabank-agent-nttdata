"c_8d255e4d093cd0c6","int-bcbs-basel-framework-2026","Basel Framework","Basel III - Basel Framework consolidado","BCBS/BIS","INT","international_standard","in_force","","2026-01-01","","https://www.bis.org/committees/bcbs/basel-framework/basel-framework.pdf","fuentes_descargadas/02_normativa_internacional/18_bis_basel_framework_2026.pdf","acf3759fc231fb8f13131e50b12ad11e18bc9ebe53f105595fd8e16609a3547f","int-bcbs-basel-framework-2026#nsec-25-occ3","25","numbered_section","DIS Disclosure requirements > 25 Composition of capital and TLAC > num. 25.5","1183","1183","Retained earnings
