.venv/
__pycache__/
*.pyc
.env
*.egg-info/
.pytest_cache/
.ruff_cache/
.claude/

# Corpus y artefactos locales reproducibles. Solo se versionan los metadatos de la captura.
/fuentes_descargadas/**
!/fuentes_descargadas/README.md
!/fuentes_descargadas/manifest.json
!/fuentes_descargadas/validacion_fuentes.csv
/tmp/
/.tmp/

